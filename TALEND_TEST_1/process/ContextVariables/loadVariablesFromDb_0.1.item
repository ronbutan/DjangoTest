    <elementParameter field="MEMO_JAVA" name="CODE_MAIN" value="// here is the main part of the component,&#xA;// a piece of code executed in the row&#xA;// loop&#xA;if (row2.file_regex != null &amp;&amp; !row2.file_regex.trim().isEmpty()) {&#xA;    fileRegexList.add(row2.file_regex.trim());&#xA;}"/>
    <elementParameter field="MEMO_JAVA" name="CODE_END" value="// end of the component, outside/closing the loop&#xA;globalMap.put(&quot;fileRegexList&quot;, fileRegexList);&#xA;&#xA;// Combine into one regex: (regex1)|(regex2)|...&#xA;String combined = fileRegexList.isEmpty() ? null : &quot;(&quot; + String.join(&quot;)|(&quot;, fileRegexList) + &quot;)&quot;;&#xA;context.file_regex = combined;&#xA;if (combined != null) context.setProperty(&quot;file_regex&quot;, combined);&#xA;&#xA;System.out.println(&quot;Loaded &quot; + fileRegexList.size() + &quot; file rule(s) for &quot; + globalMap.get(&quot;systemName&quot;));&#xA;System.out.println(&quot;Loaded &quot; + context.getProperty(&quot;source_location&quot;));  "/>
