  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="600" posY="-40">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="context.setProperty(&quot;system_name&quot;, input_row.system_name);&#xA;context.source_location = input_row.source_location;&#xA;context.setProperty(&quot;source_location&quot;, input_row.source_location);&#xA;context.setProperty(&quot;destination_location&quot;, input_row.destination_location);&#xA;context.setProperty(&quot;retention_days&quot;, String.valueOf(input_row.retention_days));&#xA;System.out.println(context.source_location);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
